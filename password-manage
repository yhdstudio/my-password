<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CipherVault - 密碼與保險安全管家</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
        .glass { backdrop-filter: blur(12px); }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen transition-colors duration-200">

    <!-- 主密碼驗證解密遮罩 -->
    <div id="authOverlay" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/80 backdrop-blur-md p-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 max-w-md w-full shadow-2xl space-y-6">
            <div class="text-center space-y-2">
                <div class="inline-flex p-3 rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 mb-2">
                    <i data-lucide="shield-check" class="w-10 h-10"></i>
                </div>
                <h2 class="text-2xl font-bold tracking-tight">CipherVault 安全管家</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400" id="authSubtitle">請輸入主密碼以解密並載入您的帳號與保險資料</p>
            </div>

            <form id="authForm" onsubmit="handleAuth(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">主解密密碼 (Master Password)</label>
                    <div class="relative">
                        <input type="password" id="masterPasswordInput" required placeholder="••••••••••••" 
                            class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 pr-10">
                        <button type="button" onclick="togglePasswordVisibility('masterPasswordInput')" class="absolute right-3 top-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                            <i data-lucide="eye" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium rounded-xl transition shadow-lg shadow-indigo-500/25 flex items-center justify-center gap-2">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    <span>解密保險庫</span>
                </button>
            </form>
            <div id="authError" class="hidden text-xs text-red-500 text-center font-medium">主密碼錯誤，請重新輸入</div>
        </div>
    </div>

    <!-- 主要應用介面 -->
    <div id="app" class="hidden min-h-screen flex flex-col md:flex-row">
        
        <!-- 側邊欄 Sidebar -->
        <aside class="w-full md:w-64 bg-white dark:bg-slate-900 border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 p-4 flex flex-col justify-between shrink-0">
            <div class="space-y-6">
                <!-- 標題與標誌 -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="p-2 bg-indigo-600 text-white rounded-xl">
                            <i data-lucide="shield" class="w-6 h-6"></i>
                        </div>
                        <span class="font-bold text-lg tracking-wide">CipherVault</span>
                    </div>
                    <!-- 主題切換按鈕 (行動端) -->
                    <button onclick="toggleTheme()" class="md:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                        <i data-lucide="moon" class="w-5 h-5 block dark:hidden"></i>
                    </button>
                </div>

                <!-- 分類導覽 -->
                <nav class="space-y-1">
                    <button onclick="filterCategory('all')" id="cat-all" class="cat-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                        <span>全部項目</span>
                        <span id="count-all" class="ml-auto text-xs px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0</span>
                    </button>

                    <button onclick="filterCategory('insurance')" id="cat-insurance" class="cat-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <i data-lucide="shield-alert" class="w-4 h-4 text-emerald-500"></i>
                        <span>保險與健保</span>
                        <span id="count-insurance" class="ml-auto text-xs px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0</span>
                    </button>

                    <button onclick="filterCategory('account')" id="cat-account" class="cat-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <i data-lucide="key-round" class="w-4 h-4 text-blue-500"></i>
                        <span>網路帳號密碼</span>
                        <span id="count-account" class="ml-auto text-xs px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0</span>
                    </button>

                    <button onclick="filterCategory('bank')" id="cat-bank" class="cat-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <i data-lucide="credit-card" class="w-4 h-4 text-amber-500"></i>
                        <span>金融與信用卡</span>
                        <span id="count-bank" class="ml-auto text-xs px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400">0</span>
                    </button>
                </nav>
            </div>

            <!-- 底部功能按鈕 -->
            <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 space-y-2">
                <button onclick="toggleTheme()" class="hidden md:flex w-full items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                    <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                    <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
                    <span id="themeLabel">切換亮色模式</span>
                </button>
                <button onclick="exportData()" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>匯出備份 (JSON)</span>
                </button>
                <button onclick="lockVault()" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    <span>鎖定保險庫</span>
                </button>
            </div>
        </aside>

        <!-- 主要內容區 Main Content -->
        <main class="flex-1 p-4 sm:p-8 space-y-6 overflow-y-auto">
            
            <!-- 頂部操作列 Header Bar -->
            <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center justify-between">
                <!-- 搜尋列 -->
                <div class="relative flex-1 max-w-md">
                    <i data-lucide="search" class="w-5 h-5 absolute left-3.5 top-3 text-slate-400"></i>
                    <input type="text" id="searchInput" oninput="renderItems()" placeholder="搜尋產品、保單號碼、使用者名稱..." 
                        class="w-full pl-11 pr-4 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- 按鈕區 -->
                <div class="flex items-center gap-2">
                    <button onclick="openAddModal()" class="flex-1 sm:flex-initial px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-xl transition shadow-lg shadow-indigo-500/20 flex items-center justify-center gap-2">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span>新增紀錄</span>
                    </button>
                </div>
            </div>

            <!-- 資料卡片列表 Grid -->
            <div id="itemsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- 內容動態插入 -->
            </div>

            <!-- 空狀態指示 Empty State -->
            <div id="emptyState" class="hidden flex-col items-center justify-center py-16 text-center space-y-3">
                <div class="p-4 rounded-full bg-slate-100 dark:bg-slate-900 text-slate-400">
                    <i data-lucide="inbox" class="w-10 h-10"></i>
                </div>
                <p class="text-slate-500 dark:text-slate-400 font-medium">尚無相關帳號或保險資料</p>
                <button onclick="openAddModal()" class="text-xs text-indigo-500 font-semibold hover:underline">點此立即新增第一筆紀錄</button>
            </div>
        </main>
    </div>

    <!-- 新增/編輯 Modal -->
    <div id="itemModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-6 my-8 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
                <h3 class="text-lg font-bold" id="modalTitle">新增資料項目</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form id="itemForm" onsubmit="saveItem(event)" class="space-y-4">
                <input type="hidden" id="itemId">

                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">資料類別</label>
                    <select id="itemCategory" onchange="toggleCategoryFields()" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="insurance">🛡️ 保險與健保 (Insurance)</option>
                        <option value="account">🔑 網路帳號密碼 (Account)</option>
                        <option value="bank">💳 金融與信用卡 (Bank)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">名稱 / 服務平台</label>
                    <input type="text" id="itemName" required placeholder="例如：中央健康保險署、國泰人壽、Google..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- 保險專用欄位 -->
                <div id="insuranceFields" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">保單號碼 / 身分證字號 / 健保號碼</label>
                        <input type="text" id="policyNumber" placeholder="例如：1234567890" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <!-- 帳號與密碼欄位 -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">帳號 / 使用者名稱 / 登入ID</label>
                        <input type="text" id="itemUsername" placeholder="user@example.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">密碼</label>
                        <div class="relative">
                            <input type="password" id="itemPassword" placeholder="••••••••••••" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 pr-10">
                            <button type="button" onclick="togglePasswordVisibility('itemPassword')" class="absolute right-3 top-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">備註 / 投保內容說明</label>
                    <textarea id="itemNotes" rows="3" placeholder="填寫投保金額、理賠電話、續保日期或備忘資訊..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
                </div>

                <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <button type="button" onclick="closeModal()" class="flex-1 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">取消</button>
                    <button type="submit" class="flex-1 py-2.5 text-sm font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-md shadow-indigo-500/20">儲存資料</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 腳本邏輯 JavaScript -->
    <script>
        let vaultData = [];
        let masterCryptoKey = null;
        let activeCategory = 'all';

        // 初始化圖示與主題
        document.addEventListener('DOMContentLoaded', () => {
            initTheme();
            lucide.createIcons();
            checkExistingVault();
        });

        // 暗黑 / 亮色主題切換
        function initTheme() {
            const savedTheme = localStorage.getItem('cipher_theme') || 'dark';
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('cipher_theme', isDark ? 'dark' : 'light');
        }

        // 加密金鑰生成 (PBKDF2 + AES-GCM)
        async function deriveKey(password, salt) {
            const enc = new TextEncoder();
            const keyMaterial = await crypto.subtle.importKey(
                "raw", enc.encode(password), "PBKDF2", false, ["deriveKey"]
            );
            return crypto.subtle.deriveKey(
                {
                    name: "PBKDF2",
                    salt: enc.encode(salt),
                    iterations: 100000,
                    hash: "SHA-256"
                },
                keyMaterial,
                { name: "AES-GCM", length: 256 },
                false,
                ["encrypt", "decrypt"]
            );
        }

        async function encryptData(data, key) {
            const enc = new TextEncoder();
            const iv = crypto.getRandomValues(new Uint8Array(12));
            const encrypted = await crypto.subtle.encrypt(
                { name: "AES-GCM", iv: iv },
                key,
                enc.encode(JSON.stringify(data))
            );
            return {
                iv: Array.from(iv),
                ciphertext: Array.from(new Uint8Array(encrypted))
            };
        }

        async function decryptData(encryptedObj, key) {
            const dec = new TextDecoder();
            const iv = new Uint8Array(encryptedObj.iv);
            const ciphertext = new Uint8Array(encryptedObj.ciphertext);
            const decrypted = await crypto.subtle.decrypt(
                { name: "AES-GCM", iv: iv },
                key,
                ciphertext
            );
            return JSON.parse(dec.decode(decrypted));
        }

        // 檢查是否存在舊資料庫
        function checkExistingVault() {
            const vault = localStorage.getItem('cipher_vault_encrypted');
            if (!vault) {
                document.getElementById('authSubtitle').innerText = "首次使用！請設定您的主加密密碼（請務必牢記）";
            }
        }

        // 登入 / 解密處理
        async function handleAuth(e) {
            e.preventDefault();
            const password = document.getElementById('masterPasswordInput').value;
            const vault = localStorage.getItem('cipher_vault_encrypted');

            try {
                masterCryptoKey = await deriveKey(password, "CipherVaultStaticSalt2026");

                if (vault) {
                    const encryptedObj = JSON.parse(vault);
                    vaultData = await decryptData(encryptedObj, masterCryptoKey);
                } else {
                    // 初始化預設健保資料
                    vaultData = [{
                        id: Date.now().toString(),
                        category: 'insurance',
                        name: '中央健康保險署 (健保快易通)',
                        policyNumber: 'A123456789',
                        username: 'huaixi2000@gmail.com',
                        password: 'DemoPassword123',
                        notes: '包含健保卡號碼、虛擬健保卡與網路繳費查詢資訊。',
                        updatedAt: new Date().toLocaleDateString()
                    }];
                    await saveVaultLocally();
                }

                document.getElementById('authOverlay').classList.add('hidden');
                document.getElementById('app').classList.remove('hidden');
                renderItems();
            } catch (err) {
                console.error(err);
                document.getElementById('authError').classList.remove('hidden');
            }
        }

        // 儲存至 localStorage
        async function saveVaultLocally() {
            const encrypted = await encryptData(vaultData, masterCryptoKey);
            localStorage.setItem('cipher_vault_encrypted', JSON.stringify(encrypted));
        }

        // 渲染列表卡片
        function renderItems() {
            const grid = document.getElementById('itemsGrid');
            const emptyState = document.getElementById('emptyState');
            const search = document.getElementById('searchInput').value.toLowerCase();

            grid.innerHTML = '';

            const filtered = vaultData.filter(item => {
                const matchesCat = activeCategory === 'all' || item.category === activeCategory;
                const matchesSearch = item.name.toLowerCase().includes(search) || 
                                      (item.policyNumber && item.policyNumber.toLowerCase().includes(search)) ||
                                      (item.username && item.username.toLowerCase().includes(search));
                return matchesCat && matchesSearch;
            });

            // 更新計數器
            document.getElementById('count-all').innerText = vaultData.length;
            document.getElementById('count-insurance').innerText = vaultData.filter(i => i.category === 'insurance').length;
            document.getElementById('count-account').innerText = vaultData.filter(i => i.category === 'account').length;
            document.getElementById('count-bank').innerText = vaultData.filter(i => i.category === 'bank').length;

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
            } else {
                emptyState.classList.add('hidden');
                emptyState.classList.remove('flex');

                filtered.forEach(item => {
                    const card = document.createElement('div');
                    card.className = "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-md transition space-y-4 flex flex-col justify-between";
                    
                    let catBadge = '';
                    if(item.category === 'insurance') catBadge = '<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🛡️ 保險與健保</span>';
                    else if(item.category === 'bank') catBadge = '<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">💳 金融卡號</span>';
                    else catBadge = '<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">🔑 帳號密碼</span>';

                    card.innerHTML = `
                        <div class="space-y-3">
                            <div class="flex items-start justify-between gap-2">
                                <h4 class="font-bold text-base tracking-tight text-slate-900 dark:text-white line-clamp-1">${escapeHtml(item.name)}</h4>
                                ${catBadge}
                            </div>

                            ${item.policyNumber ? `
                            <div class="bg-slate-50 dark:bg-slate-800/50 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 space-y-0.5">
                                <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold block">保單號碼 / 身分識別</span>
                                <div class="flex items-center justify-between font-mono text-xs font-semibold text-slate-700 dark:text-slate-200">
                                    <span>${escapeHtml(item.policyNumber)}</span>
                                    <button onclick="copyToClipboard('${escapeJs(item.policyNumber)}')" class="text-slate-400 hover:text-indigo-500 p-1">
                                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>
                            ` : ''}

                            <div class="space-y-1.5 text-xs">
                                ${item.username ? `
                                <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                                    <span class="text-slate-400">帳號:</span>
                                    <div class="flex items-center gap-1 font-mono">
                                        <span>${escapeHtml(item.username)}</span>
                                        <button onclick="copyToClipboard('${escapeJs(item.username)}')" class="text-slate-400 hover:text-indigo-500 p-1">
                                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </div>
                                ` : ''}

                                ${item.password ? `
                                <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                                    <span class="text-slate-400">密碼:</span>
                                    <div class="flex items-center gap-1 font-mono">
                                        <span>••••••••</span>
                                        <button onclick="copyToClipboard('${escapeJs(item.password)}')" class="text-slate-400 hover:text-indigo-500 p-1">
                                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </div>
                                ` : ''}
                            </div>

                            ${item.notes ? `
                            <p class="text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/30 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/50 line-clamp-2">${escapeHtml(item.notes)}</p>
                            ` : ''}
                        </div>

                        <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800/80 text-xs">
                            <span class="text-slate-400 text-[10px]">更新於 ${item.updatedAt || '近期'}</span>
                            <div class="flex items-center gap-2">
                                <button onclick="editItem('${item.id}')" class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteItem('${item.id}')" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    `;
                    grid.appendChild(card);
                });
            }
            lucide.createIcons();
        }

        // 分類過濾
        function filterCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-50', 'text-indigo-600', 'dark:bg-indigo-900/30', 'dark:text-indigo-400');
                btn.classList.add('text-slate-600', 'dark:text-slate-400');
            });
            const activeBtn = document.getElementById(`cat-${cat}`);
            if(activeBtn) {
                activeBtn.classList.add('bg-indigo-50', 'text-indigo-600', 'dark:bg-indigo-900/30', 'dark:text-indigo-400');
            }
            renderItems();
        }

        // 表單切換欄位
        function toggleCategoryFields() {
            const cat = document.getElementById('itemCategory').value;
            const insFields = document.getElementById('insuranceFields');
            if(cat === 'insurance') {
                insFields.classList.remove('hidden');
            } else {
                insFields.classList.add('hidden');
            }
        }

        // 開啟 / 關閉 Modal
        function openAddModal() {
            document.getElementById('modalTitle').innerText = "新增紀錄";
            document.getElementById('itemForm').reset();
            document.getElementById('itemId').value = '';
            toggleCategoryFields();
            document.getElementById('itemModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('itemModal').classList.add('hidden');
        }

        function editItem(id) {
            const item = vaultData.find(i => i.id === id);
            if (!item) return;

            document.getElementById('modalTitle').innerText = "編輯資料紀錄";
            document.getElementById('itemId').value = item.id;
            document.getElementById('itemCategory').value = item.category || 'account';
            document.getElementById('itemName').value = item.name || '';
            document.getElementById('policyNumber').value = item.policyNumber || '';
            document.getElementById('itemUsername').value = item.username || '';
            document.getElementById('itemPassword').value = item.password || '';
            document.getElementById('itemNotes').value = item.notes || '';

            toggleCategoryFields();
            document.getElementById('itemModal').classList.remove('hidden');
        }

        async function saveItem(e) {
            e.preventDefault();
            const id = document.getElementById('itemId').value;
            const itemData = {
                id: id || Date.now().toString(),
                category: document.getElementById('itemCategory').value,
                name: document.getElementById('itemName').value,
                policyNumber: document.getElementById('policyNumber').value,
                username: document.getElementById('itemUsername').value,
                password: document.getElementById('itemPassword').value,
                notes: document.getElementById('itemNotes').value,
                updatedAt: new Date().toLocaleDateString()
            };

            if (id) {
                const idx = vaultData.findIndex(i => i.id === id);
                if (idx !== -1) vaultData[idx] = itemData;
            } else {
                vaultData.push(itemData);
            }

            await saveVaultLocally();
            closeModal();
            renderItems();
        }

        async function deleteItem(id) {
            if (confirm("確定要刪除此筆資料嗎？此操作無法復原。")) {
                vaultData = vaultData.filter(i => i.id !== id);
                await saveVaultLocally();
                renderItems();
            }
        }

        // 複製工具
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                alert("已成功複製到剪貼簿！");
            });
        }

        // 匯出備份
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(vaultData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `CipherVault_Backup_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        // 鎖定保險庫
        function lockVault() {
            masterCryptoKey = null;
            vaultData = [];
            document.getElementById('app').classList.add('hidden');
            document.getElementById('authOverlay').classList.remove('hidden');
            document.getElementById('masterPasswordInput').value = '';
        }

        // 密碼顯示切換
        function togglePasswordVisibility(inputId) {
            const input = document.getElementById(inputId);
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        // 安全字串轉義
        function escapeHtml(str) {
            return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
        function escapeJs(str) {
            return (str || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
        }
    </script>
</body>
</html>
